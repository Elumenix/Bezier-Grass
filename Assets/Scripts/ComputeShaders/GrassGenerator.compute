// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel CSMain
#include "./Assets/Shaders/Includes/GrassBlade.cginc"

// Our main goal here is to get instance information for each grass blade we will render
AppendStructuredBuffer<GrassBlade> grassBlades;
Texture2D<float> heightTex;
Texture2D<float4> normalMapTex;

float4 frustumData[6];
uint patternSize;
float scale;
float heightScale;
float clumpSeparation;
float clumpDirection;
float grassDist;
float swapRange;

// World space positions
float3 tileStartPosition;
float4 mapBounds; // Beginning xy, End zw
float3 cameraPos;
static const float3 up = float3(0,1,0);

cbuffer GrassShape 
{
    float grassLength;
    float tilt;
    float bend;
    float lengthVariance;
    float tiltVariance;
    float bendVariance;
};

// Gpu math optimizations were causing flickering, so they've been disabled with the precise keyword
precise float2 rand2(float2 p)
{
    float3 p3 = frac(float3(p.xyx) * float3(.1031, .1030, .0973));
    p3 += dot(p3, p3.yzx+33.33);
    return frac((p3.xx+p3.yz)*p3.zy);
}

float rand(float3 p)
{
    return frac(sin(dot(p.xyz, float3(12.9898, 78.233, 53.539))) * 43758.5453);
}

/*float pcg_float(uint input) {
    uint state = input * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return float((word >> 22u) ^ word) * (1.0f / 4294967295.0f);
}*/

bool isVisible(float3 bladePos)
{
    // If the blade is off the map, we can return and don't need to loop. This will only happen after clump logic plays out
    if (bladePos.x < mapBounds.x || bladePos.z < mapBounds.y || bladePos.x > mapBounds.z || bladePos.z > mapBounds.w) return false;
    
    // The way that frustum culling works is if the sphere is outside any plane, then it is not visible
    for (int i = 0; i < 6; i++)
    {
        // We assume the blade has a radius of 3. This helps get the tip of the blade in since it's randomly
        // directed away from the base (which is bladePos). Spherical bounds tests are also more efficient than AABB
        if (dot(frustumData[i].xyz, bladePos) + frustumData[i].w < -3) return false;
    }

    return true;
}

float2 Rotate2D(float2 v, float angle)
{
    float c = cos(angle);
    float s = sin(angle);
    return float2(
        v.x * c - v.y * s,
        v.x * s + v.y * c
    );
}

[numthreads(8,1,8)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    // Each thread covers a 2x2 space. This is the top left corner of that space for this thread
    uint2 threadCell = int2(id.x * 2, id.z * 2);
    
    // Each thread handles 4 grass blades so that less thread groups and threads are needed to fill the scene
    for (uint i = 0; i < 4; i++)
    {
        // PART 1:
        // We first want to determine the position of each grass blade in the world, slightly randomized for good distribution.
        // We also want to confirm if the grass blade is visible to the player, if not we don't need to do any more calculations on it.

        // Select Quadrant: (0,0), (1,0), (0,1), (1,1)
        uint2 quadOrigin = threadCell + int2((i%2), (i/2));
        
        // Slightly jitter points within their defined position so grass doesn't look completely uniform
        float2 gridPos = tileStartPosition.xz + float2(quadOrigin) * grassDist; 
        float2 offsetPos = gridPos + rand2(gridPos * float2(3.25f, 9.91563f)) * grassDist; // Jitter point within quadrant 
        float3 worldPos = float3(offsetPos.x, tileStartPosition.y, offsetPos.y);

        // Read the terrain heightMap so that we can put each grass blade at the correct elevation
        uint idX = round(Remap(mapBounds.x, mapBounds.z, 0.0, 1.0, worldPos.x) * 511.0);
        uint idZ = round(Remap(mapBounds.y, mapBounds.w, 0.0, 1.0, worldPos.z) * 511.0);
        float h = heightTex.Load(int3(idX, idZ, 0)) * heightScale;
        worldPos.y = tileStartPosition.y + h;

        float dist = distance(cameraPos, worldPos);

        // Early out if the blade wouldn't be visible. Don't add it to the appendBuffer because it shouldn't be rendered
        // This also takes some of the write contention away from the buffer for this chunks shader call
        // Less blades are drawn in the distance because the user won't necessarily be able to see them anymore
        if (dist > swapRange + i * swapRange || !isVisible(worldPos)) continue;


        // PART 2:
        // A voronoi noise map will be created in world space to partition the grass into groups.
        // Values of the map will be used to alter the grass behavior in order to visually create natural grass clumps.
        
        // Variables to set up the Voronoi Noise
        float2 uv = offsetPos / scale; // offset Pos means a full voronoi map is per tile instead of world
        float2 baseCell = floor(uv);
        float minDistUV = 100000.0; // Larger than any possible cell
        float2 closestCellPos;
    
        // Voronoi Noise Implementation
        [unroll]
        for (int x = -1; x <= 1; x++)
        {
            [unroll]
            for (int y = -1; y <= 1; y++)
            {
                float2 cell = baseCell + float2(x,y);
                float2 wrappedCell = fmod(cell + patternSize, patternSize);
                        
                float2 cellPosition = cell + rand2(wrappedCell);
                float2 diff = cellPosition - uv;


                if (abs(diff.x) > patternSize * 0.5f) {
                    diff.x -= sign(diff.x) * patternSize;
                }
                if (abs(diff.y) > patternSize * 0.5f) {
                    diff.y -= sign(diff.y) * patternSize;
                }

            
                float distToCell = length(diff);
                if (distToCell < minDistUV)
                {
                    // Distance to the nearest cell in uv space
                    minDistUV = distToCell;

                    // Unwrapping the wrapped uv space position to world space
                    closestCellPos = cellPosition - float2(abs(diff.x) > patternSize * .5f ? sign(diff.x) * patternSize : 0,
                        abs(diff.y) > patternSize * .5f ? sign(diff.y) * patternSize : 0);
                }
            }
        }

        // puts cell position into worldSpace
        float2 voronoiCell = closestCellPos * scale;


        // PART 3:
        // The position and voronoi will be used to generate random values that will be used to shape each grass blade
        float2 clumpFacing = normalize(tan(rand2(voronoiCell) + float2(.31, 3.1267)) * 2.0f - 1);
        float2 facing2D = normalize(rand2(worldPos.xz) * 2.0f - 1); // Between -1 and 1
        float2 facing = normalize(lerp(facing2D, clumpFacing, clumpDirection)); // Turns by clump direction parameter
        float3 widthDir = float3(facing.y, 0, -facing.x); // Orthogonal normal to facing

        float bladeLength = clamp(grassLength + (rand(worldPos.xxz) * 2 - 1) * lengthVariance, .01f, 10.0f);
        float bladeTilt = clamp(tilt + (rand(worldPos.zxx) * 2 - 1) * tiltVariance, 0.0f, 1.0f);
        float bladeBend = clamp(bend + (rand(worldPos.xzx) * 2 - 1) * bendVariance, 0.0f, 3.0f);



        if (_WindPower > 0 && _WindSpeed > 0)
        {
            // Per-blade random value (consistent for each blade based on its position)
            float bladeRandom = frac(sin(dot(worldPos.xz, float2(12.9898, 78.233))) * 43758.5453);
            float windStrength = _WindPower * lerp(0.70, 1.5, bladeRandom); // Each blade 70% to 150% responsive


            float n1 = perlin(worldPos.xz * _WindScale * 0.5 + _Time.y * _WindSpeed * 0.2);
            float n2 = perlin(worldPos.xz * _WindScale * 1.0 + _Time.y * _WindSpeed * 1);
            float n3 = perlin(worldPos.xz * _WindScale * 2.5 + _Time.y * _WindSpeed * 1.8);
            
            
            bladeTilt = clamp(bladeTilt + n1 * windStrength * .25, 0, .9);
            bladeBend = clamp(bladeBend + n2 * windStrength * .75 + n3 * windStrength * .15, 0, 3);
        }
        
        
        // PART 4:
        // Get the four control points of the Cubic Bézier Curve that will determine the blades shape
        float3 p0 = float3(0,0,0); // Root of the grass blade in object space.

        // Bézier curve math when we weren't using arcs for a better curve
        float p3y = bladeTilt * bladeLength;
        float p3x = sqrt(bladeLength * bladeLength - p3y * p3y);

        // Tip gets a bit closer to the base when the blade bends so that arc length is a bit more predictable
        // Generally, this is just to make it not look like the blade grows and shrinks as it gets affected by wind
        float bendPenalty = 1 - (bladeBend * bladeBend) / (bladeLength * bladeLength * 4);
        float3 p3 = float3(p3x * facing.x, p3y, p3x * facing.y) * bendPenalty ;// Tip of the blade. Rotated to point in facing direction
        
        float3 bladeDir = normalize(p3);
        float3 awayDir = float3(0, bladeDir.y, 0);

        // Towards the middle and away from the blade. Predominantly controls how bent the blade is
        float3 p1 = p3 * .33f + awayDir * bladeBend * .5f;
        float3 p2 = p3 * .66f + awayDir * bladeBend * .75f;

        
        
        // PART 5:
        // Put together the struct for the blade and make sure it is visible
        GrassBlade blade;
        float3 newBladePosition = worldPos;
        newBladePosition.xz = lerp(worldPos.xz, voronoiCell, clumpSeparation);
        blade.position = newBladePosition;
        blade.hash = rand(worldPos.zyx);
        blade.dimensions = float2(-.2f, bladeLength); // Tilt is the length (Which most closely follows arcLength)
        blade.widthDir = widthDir;

        if (!isVisible(newBladePosition)) continue;

        // Terrain normal calculated so we can reduce antialiasing later
        float2 mapSize = mapBounds.zw - mapBounds.xy;
        float2 terrainUV = (newBladePosition.xz - mapBounds.xy) / mapSize;
        float4 normalData = normalMapTex.SampleLevel(sampler_LinearClamp, terrainUV, 0);
        float3 terrainNormal = normalData.xyz * 2.0 - 1.0; // [0,1] to [-1,1]
        blade.terrainNormal = normalize(terrainNormal);
        
        // PART 6:
        // Compute the coefficients for a Bézier curve evaluation
        // Using the coefficients instead of the points will drastically cut down on the amount of math needed in the
        // vertex shader for each grass blade as much of the following math can be simplified to the coefficients.
        float3 c0 = p0;                        // Offset
        float3 c1 = 3 * (p1 - p0);             // t
        float3 c2 = 3 * (p0 - 2 * p1 + p2);    // t^2
        float3 c3 = p3 - 3 * p2 + 3 * p1 - p0; // t^3
        blade.coefficients = float4x3(c0, c1, c2, c3);
        
        // Add this to the blades that will be rendered next frame
        grassBlades.Append(blade);
    }
}
